import rclpy
i
from rclpy.node import Node
from std_msgs.msg import String, Int32

class TopicMultiplexer(Node):
    def __init__(self):
        super().__init__('topic_multiplexer')

        # Huidige actieve inputkanaal (standaard op 1)
        self.selected_channel = 1

        # 1. Maak de Publisher voor de uiteindelijke output
        self.publisher_ = self.create_publisher(String, 'mux_output', 10)

        # 2. Maak Subscribers voor de data-inputs
        self.sub_in1 = self.create_subscription(
            String, 'input_topic_1', self.callback_in1, 10)
        
        self.sub_in2 = self.create_subscription(
            String, 'input_topic_2', self.callback_in2, 10)

        # 3. Maak een Subscriber om het actieve kanaal te selecteren
        self.sub_select = self.create_subscription(
            Int32, 'mux_select', self.callback_select, 10)

        self.get_logger().info('Multiplexer gestart. Actief kanaal: 1')

    def callback_select(self, msg):
        """Wordt aangeroepen wanneer we een nieuw kanaal willen selecteren."""
        if msg.data in [1, 2]:
            self.selected_channel = msg.data
            self.get_logger().info(f'Succesvol geschakeld naar kanaal: {self.selected_channel}')
        else:
            self.get_logger().warn('Ongeldige kanaalselectie. Gebruik kanaal 1 of 2.')

    def callback_in1(self, msg):
        """Verwerkt berichten van input_topic_1."""
        if self.selected_channel == 1:
            self.publisher_.publish(msg)

    def callback_in2(self, msg):
        """Verwerkt berichten van input_topic_2."""
        if self.selected_channel == 2:
            self.publisher_.publish(msg)

def main(args=None):
    rclpy.init(args=args)
    mux_node = TopicMultiplexer()
    
    try:
        rclpy.spin(mux_node)
    except KeyboardInterrupt:
        mux_node.get_logger().info('Multiplexer node gestopt door gebruiker.')
    finally:
        mux_node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
