<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3" main_tree_to_execute="MainTree">

  <BehaviorTree ID="MainTree">
    <Sequence name="WaitForInitialRobotState">
      <RobotStateReady/>
      <Fallback name="GlobalSafetyFallback">

      <!-- ========================================= -->
      <!-- ROBOT STAAT REEDS AAN DE LADER            -->
      <!-- ========================================= -->
      <Sequence name="AlreadyCharging">
        <!-- Hangt de robot fysiek aan de lader? -->
        <IsRobotCharging/>
        <!-- Is de robot momenteel INACTIEF? (Indien actief gemaakt met de knop, faalt deze tak) -->
        <Inverter>
          <CheckRobotActive/>
        </Inverter>
        <!-- Zolang hij laadt en inactief is, blijft hij hier hangen -->
        <SetRobotInactive/>
      </Sequence>

      <!-- ========================================= -->
      <!-- AUTONOME MISSIE                           -->
      <!-- ========================================= -->
      <ReactiveSequence name="AutonomeMissie">
        <CheckRobotActive/>
        <BatteryOk/>

        <!-- Indien nog tegen de laadpaal, rijd er eerst vandaan -->
        <Fallback name="UndockIfNeeded">
          <Inverter>
            <IsRobotDocked/>
          </Inverter>
          <ExecuteUndockDrive/>
        </Fallback>

        <!-- Naar werkzone indien nodig -->
        <Fallback name="EnsureWorkingZone">
          <IsRobotAtWorkArea/>
          <SendDriveWorkArea/>
        </Fallback>

        <!-- Missielogica -->
        <Fallback name="MissionControl">

          <!-- 1. QUIZ (Allerhoogste prioriteit) -->
          <ReactiveSequence name="QuizPreparationAndExecution">
            <WantToStartQuiz/>
            <Fallback name="NavigateToQuizLocation">
              <IsRobotAtQuiz/>
              <Fallback name="LocationSelector">
                <SendDriveQuizLocationA/>
                <SendDriveQuizLocationB/>
              </Fallback>
            </Fallback>
            <ExecuteActiveQuiz/>
          </ReactiveSequence>

          <!-- 2. MENS DETECTIE (Prioriteit over reguliere patrouille) -->
          <ReactiveSequence name="InteractieMetBezoekers">
            <IsPersonDetected/>
            <Sequence name="WervingsFlow">
              <StartDrivingToPeople/>
              <CheckingNearbyVisitors/>
              <RobotRotationFollowMe/>
            </Sequence>
          </ReactiveSequence>

          <!-- 3. PATROUILLE LUS (C -> D -> E) -->
          <!-- Gewone Sequence zorgt voor een reset naar punt C na een onderbreking/quiz -->
          <Sequence name="WervingsPatrouille">
            
            <!-- ROUTE EN 20 SEC WACHTEN OP PUNT C -->
            <ForceSuccess>
              <Fallback name="AfhandelingPuntC">
                <Sequence name="WachtOpC">
                  <IsRobotAtLocationC/>
                  <Delay delay_msec="20000">
                    <AlwaysSuccess/>
                  </Delay>
                </Sequence>
                <SendDriveLocationC/>
              </Fallback>
            </ForceSuccess>

            <!-- ROUTE EN 20 SEC WACHTEN OP PUNT D -->
            <ForceSuccess>
              <Fallback name="AfhandelingPuntD">
                <Sequence name="WachtOpD">
                  <IsRobotAtLocationD/>
                  <Delay delay_msec="20000">
                    <AlwaysSuccess/>
                  </Delay>
                </Sequence>
                <SendDriveLocationD/>
              </Fallback>
            </ForceSuccess>

            <!-- ROUTE EN 20 SEC WACHTEN OP PUNT E -->
            <ForceSuccess>
              <Fallback name="AfhandelingPuntE">
                <Sequence name="WachtOpE">
                  <IsRobotAtLocationE/>
                  <Delay delay_msec="20000">
                    <AlwaysSuccess/>
                  </Delay>
                </Sequence>
                <SendDriveLocationE/>
              </Fallback>
            </ForceSuccess>

          </Sequence>

        </Fallback>
      </ReactiveSequence>

      <!-- ========================================= -->
      <!-- BATTERIJ ONVOLDOENDE                      -->
      <!-- ========================================= -->
      <Sequence name="ExitFlow">
        <Fallback name="ExitRequested">
          <Inverter>
            <CheckRobotActive/>
          </Inverter>
          <Inverter>
            <BatteryOk/>
          </Inverter>
        </Fallback>
        <Fallback name="NavigateToChargingArea">
          <IsRobotNearChargingStation/>
          <SendDriveToChargingArea/>
        </Fallback>
        <Fallback name="EnsureDocked">
          <IsRobotCharging/>
          <StartInfraroodDocking/>
        </Fallback>
        <IsRobotCharging/>
        <SetRobotInactive/>
      </Sequence>

      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- ========================================================= -->
  <!-- NODE MODELS                                               -->
  <!-- ========================================================= -->
  <TreeNodesModel>
    <Condition ID="CheckRobotActive"/>
    <Condition ID="BatteryOk"/>
    <Action ID="SetRobotInactive"/>
    <Condition ID="IsRobotDocked"/>
    <Condition ID="RobotStateReady"/>
    <Action ID="ExecuteUndockDrive"/>
    <Condition ID="IsRobotAtWorkArea"/>
    <Action ID="SendDriveWorkArea"/>
    
    <!-- Quiz -->
    <Condition ID="WantToStartQuiz"/>
    <Condition ID="IsRobotAtQuiz"/>
    <Action ID="SendDriveQuizLocationA"/>
    <Action ID="SendDriveQuizLocationB"/>
    <Action ID="ExecuteActiveQuiz"/>
    
    <!-- Mensen werven -->
    <Condition ID="IsPersonDetected"/>
    <Action ID="StartDrivingToPeople"/>
    <Action ID="CheckingNearbyVisitors"/>
    <Action ID="RobotRotationFollowMe"/>
    
    <!-- Patrouille -->
    <Condition ID="IsRobotAtLocationC"/>
    <Action ID="SendDriveLocationC"/>
    <Condition ID="IsRobotAtLocationD"/>
    <Action ID="SendDriveLocationD"/>
    <Condition ID="IsRobotAtLocationE"/>
    <Action ID="SendDriveLocationE"/>
    
    <!-- Laden -->
    <Condition ID="IsRobotNearChargingStation"/>
    <Action ID="SendDriveToChargingArea"/>
    <Condition ID="IsRobotCharging"/>
    <Action ID="StartInfraroodDocking"/>
  </TreeNodesModel>
</root>
