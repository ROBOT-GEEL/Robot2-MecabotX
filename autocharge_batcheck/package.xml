<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autocharge_batcheck</name>
  <version>0.0.1</version>
  <description>
    Code die de afhandeling van batterijniveau doet: is deze of goed genoeg, dan schrijft hij naar file BATTERY-LOW of BATTERY-OK
  </description>
  <maintainer email="rthijs@yahoo.com">wheeltec</maintainer>
  <license>MIT</license>

  <!-- ROS 2 dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <!-- Python package dependency -->
  <exec_depend>python-socketio</exec_depend>

  <!-- Optional test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

