<root main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <Fallback name="TopFallback">
            
            <Parallel name="NetworkAndMainParallel" success_threshold="1" failure_threshold="1">
                <CheckNetworkError connection_chargeStatus="{connection_chargeStatus}"/>

                <Fallback name="AdminPanelFallback">
                    
                    <Parallel name="CheckButtonAndMainParallel" success_threshold="1" failure_threshold="1">
                        <CheckAdminPanel  robot_startup = "{robot_startup}"/> 
                        <Fallback name="BatteryLowFallback">
                            <Parallel name="RootParallel" success_threshold="1" failure_threshold="1">
                                <BatteryOk robotLocationBAT="{robotLocationBAT}"
                                           chargingInteger="{chargingInteger}"
                                           chargingInteger_nextCycle="{chargingInteger_nextCycle}"
                                           bat_admin_status="{bat_admin_status}"
                                           skip_drive2charging="{skip_drive2charging}"/>

                                <ForceSuccess name="MainFallbackForceSuccess">
                                    <Fallback name="MainFallback">
                                        <Sequence name="MainSequence">
                                            <Fallback name="CheckWorkingZone">
                                                <CheckInWorkingZone robotLocationBAT="{robotLocationBAT}" />
                                                <Sequence name="GoToWorkAreaSequence">
                                                    <DriveWorkArea timeout="5.0" x="3.372413793103448" y="15.724137931034482" z="0.0" qx="0.0" qy="0.0" qz="-0.7983486481160277" qw="0.602195513144453" workarea_timestamp="{workarea_timestamp}" />
                                                <IsRobotAtWorkArea timeout="200.0" workarea_timestamp="{workarea_timestamp}" drive_failed="{drive_failed}" />
                                                </Sequence>
                                            </Fallback>
                                            <RobotExplore robotLocation="{robotLocation}"      
                                            explore_timestamp="{explore_timestamp}"  />
                                            <LoopSequence name="LoopSequence">
                                                <Sequence name="FollowMeSequence">
                                                    <StartDrivingToPeople timeout="5.0" robot_rotate="{robot_rotate}"/>
                                                    <CheckingNearbyVisitors
                                                            distance_max="2"
                                                            timer="30.0"
                                                            zero_limit="7"
                                                            robot_rotate="{robot_rotate}" />
                                                    <RobotRotationFollowMe 
                                                            robot_rotate="{robot_rotate}" 
                                                            explore_timestamp="{explore_timestamp}"
                                                            delta_seconds="200"
                                                        />
                                                    <ArrivedAtVisitors robot_rotate="{robot_rotate}" timeout="30.0"/>
                                                </Sequence>
                                            </LoopSequence>
                                            <DriveQuizLocation timeout="2.5" x="0.0" y="20.048275862068966" z="0.0" qx="0.0" qy="0.0" qz="0.0" qw="1.0" sent_timestamp="{quiz_timestamp}" />
                                            <IsRobotAtQuiz timeout="200.0" sent_timestamp="{quiz_timestamp}" drive_failed="{drive_failed}" />
                                            <RobotAtQuiz robotLocation="{robotLocation}"/>
                                            <WaitQuizToEnd timeout="300.0"/>
                                        </Sequence>
                                        
                                        <!-- MainBTStopDrive + MainBTSetErrorFlag als sequence met drive_failed -->
                                        <Sequence name="MainSTOPSequence">
                                            <MainBTStopDrive drive_failed="{drive_failed}"/>
                                            <MainBTSetErrorFlag drive_failed="{drive_failed}"/>
                                        </Sequence>
                                    </Fallback>
                                </ForceSuccess>
                            </Parallel>

            <Fallback name="GoToChargeFallback">
                <Sequence name="ChargingSequence">

                    <Fallback name="DriveToChargingFallback">
                        <Sequence name="DriveToChargingSequence">

                            <RobotDriveToChargingStation
                                timeout="5.0"
                                skip_drive2charging="{skip_drive2charging}"
                                skip_robotdrivechargingstation="{skip_robotdrivechargingstation}"
                                charging_sent_timestamp="{charging_sent_timestamp}"
                                bat_admin_status="{bat_admin_status}"
                                connection_chargeStatus="{connection_chargeStatus}"
                                
                            />

                            <RobotIsRobotAtChargingStation
                                timeout="200.0"
                                charging_sent_timestamp="{charging_sent_timestamp}"
                                skip_drive2charging="{skip_drive2charging}"
                                skip_robotdrivechargingstation="{skip_robotdrivechargingstation}"
                                drive_failed="{drive_failed}"
                            />

                        </Sequence>

                        <RobotFailedDriveToChargingStation
                            skip_robotdrivechargingstation="{skip_robotdrivechargingstation}" />
                    </Fallback>

                    <DriveToChargingStation
                        timeout="20.0"
                        chargingInteger="{chargingInteger}"
                        skip_drive2charging="{skip_drive2charging}"
                        bat_admin_status="{bat_admin_status}"
                        skip_isrobotcharging="{skip_isrobotcharging}"
                        skip_statusDriveToChargingStation="{skip_statusDriveToChargingStation}" />

                    <StatusDriveToChargingDock
                        timeout="200.0"
                        chargingInteger="{chargingInteger}"
                        skip_drive2charging="{skip_drive2charging}"
                        skip_isrobotcharging="{skip_isrobotcharging}"
                        skip_statusDriveToChargingStation="{skip_statusDriveToChargingStation}" />

                    <IsRobotCharging
                        timeout="200"
                        chargingInteger="{chargingInteger}"
                        skip_drive2charging="{skip_drive2charging}"
                        skip_isrobotcharging="{skip_isrobotcharging}" />

                    <IsBatteryFull
                        robotLocation="{robotLocation}"
                        chargingInteger="{chargingInteger}"
                        bat_admin_status="{bat_admin_status}"
                        skip_isrobotcharging="{skip_isrobotcharging}"
                        skip_robotdrivechargingstation="{skip_robotdrivechargingstation}" />

                    <RobotWaitInChargingStation buttonStop="{buttonStop}" />

                    <StopRobotCharging
                        chargingInteger="{chargingInteger}"
                        chargingInteger_nextCycle="{chargingInteger_nextCycle}" />

                    <BatteryCharged
                        timeout="5"
                        connection_chargeStatus="{connection_chargeStatus}"
                        robotLocationBAT="{robotLocationBAT}"
                        bat_admin_status="{bat_admin_status}" />

                </Sequence>

                <BatteryStopDrive/>
            </Fallback>
                        </Fallback> 
                    </Parallel>


                        <Sequence name="AdminSequence">
                            <CheckAdminCondition 
                                robot_startup ="{robot_startup}"
                                bat_admin_status="{bat_admin_status}" 
                                chargingInteger="{chargingInteger}" 
                                chargingInteger_nextCycle="{chargingInteger_nextCycle}"/>

                            <CheckButtonState 
                                robot_startup = "{robot_startup}"
                                buttonStop="{buttonStop}"  
                                robotLocationBAT="{robotLocationBAT}" />
                        </Sequence>
                </Fallback>
            </Parallel>

            <ConnectionLost /> 
        </Fallback>
    </BehaviorTree>
</root>
