<root main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">
        <Fallback name="TopFallback">
            
            <Parallel name="NetworkAndMainParallel" success_threshold="1" failure_threshold="1">
                <CheckNetworkError connection_chargeStatus="{connection_chargeStatus}"/>

                <Fallback name="AdminPanelFallback">
                    
                    <Parallel name="CheckButtonAndMainParallel" success_threshold="1" failure_threshold="1">
                        <CheckAdminPanel/> 
                        <Fallback name="BatteryLowFallback">
                            <Parallel name="RootParallel" success_threshold="1" failure_threshold="1">
                                <BatteryOk robotLocationBAT="{robotLocationBAT}"
                                           chargingInteger="{chargingInteger}"
                                           chargingInteger_nextCycle="{chargingInteger_nextCycle}"
                                           bat_admin_status="{bat_admin_status}"
                                           skip_drive2charging="{skip_drive2charging}"/>

                                <ForceSuccess name="MainFallbackForceSuccess">
                                    <Fallback name="MainFallback">
                                        <Sequence name="MainSequence">
                                            <Fallback name="CheckWorkingZone">
                                                <CheckInWorkingZone robotLocationBAT="{robotLocationBAT}" />
                                                <Sequence name="GoToWorkAreaSequence">
                                                    <DriveWorkArea timeout="5.0" x="-2.2921230792999268" y="2.3765931129455566" z="0.0033969879150390625" qx="0.0" qy="0.0" qz="0" qw="1.0" workarea_timestamp="{workarea_timestamp}" />
                                                <IsRobotAtWorkArea timeout="200.0" workarea_timestamp="{workarea_timestamp}" drive_failed="{drive_failed}" />
                                                </Sequence>
                                            </Fallback>
                                            <RobotExplore robotLocation="{robotLocation}"/>
                                            <LoopSequence name="LoopSequence">
                                                <Sequence name="FollowMeSequence">
                                                    <StartDrivingToPeople timeout="5.0"/>
                                                    <CheckingNearbyVisitors/>
                                                    <ArrivedAtVisitors timeout="30.0"/>
                                                </Sequence>
                                            </LoopSequence>
                                            <DriveQuizLocation timeout="5.0" x="1.9707672595977783" y="0.4888995885848999" z="0.0" qx="0.0" qy="0.0" qz="0.9599275506038583" qw="0.28024827848120143" sent_timestamp="{quiz_timestamp}" />
                                            <IsRobotAtQuiz timeout="200.0" sent_timestamp="{quiz_timestamp}" drive_failed="{drive_failed}" />
                                            <RobotAtQuiz robotLocation="{robotLocation}"/>
                                            <WaitQuizToEnd timeout="120.0"/>
                                        </Sequence>
                                        
                                        <!-- MainBTStopDrive + MainBTSetErrorFlag als sequence met drive_failed -->
                                        <Sequence name="MainSTOPSequence">
                                            <MainBTStopDrive drive_failed="{drive_failed}"/>
                                            <MainBTSetErrorFlag drive_failed="{drive_failed}"/>
                                        </Sequence>
                                    </Fallback>
                                </ForceSuccess>
                            </Parallel>

                            <Fallback name="GoToChargeFallback">
                                <Sequence name="ChargingSequence">
                                    <DriveToChargingStation timeout="20.0" chargingInteger="{chargingInteger}" skip_drive2charging="{skip_drive2charging}" bat_admin_status="{bat_admin_status}" connection_chargeStatus="{connection_chargeStatus}"/>
                                    <StatusDriveToChargingDock timeout="200.0" chargingInteger="{chargingInteger}" skip_drive2charging="{skip_drive2charging}" />
                                    <IsRobotCharging timeout="200" chargingInteger="{chargingInteger}" skip_drive2charging="{skip_drive2charging}"/>
                                    <IsBatteryFull robotLocation="{robotLocation}" chargingInteger="{chargingInteger}" bat_admin_status="{bat_admin_status}" />
                                    <RobotWaitInChargingStation buttonStop = "{buttonStop}" />
                                    <StopRobotCharging chargingInteger="{chargingInteger}" chargingInteger_nextCycle="{chargingInteger_nextCycle}" />
                                    <BatteryCharged timeout="5" connection_chargeStatus="{connection_chargeStatus}" robotLocationBAT="{robotLocationBAT}" bat_admin_status ="{bat_admin_status}" />
                                </Sequence>
                                <BatteryStopDrive/>
                            </Fallback>
                        </Fallback> 
                    </Parallel>


                        <Sequence name="AdminSequence">
                            <CheckAdminCondition 
                              
                                bat_admin_status="{bat_admin_status}" 
                                chargingInteger="{chargingInteger}" 
                                chargingInteger_nextCycle="{chargingInteger_nextCycle}"/>

                            <CheckButtonState 
                                
                                buttonStop="{buttonStop}"  
                                robotLocationBAT="{robotLocationBAT}" />
                        </Sequence>
                </Fallback>
            </Parallel>

            <ConnectionLost /> 
        </Fallback>
    </BehaviorTree>
</root>
