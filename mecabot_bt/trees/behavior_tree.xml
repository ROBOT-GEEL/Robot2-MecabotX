<root main_tree_to_execute="MainTree">
    <BehaviorTree ID="MainTree">

        <Fallback name="TopFallback">

            <Parallel name="NetworkAndMainParallel" success_threshold="1" failure_threshold="1">

                <CheckNetworkError/>

                <Fallback name="InnerFallback">

                    <Parallel name="CollisionAndMainParallel" success_threshold="1" failure_threshold="1">

                        <CheckCollision/>

                        <Fallback name="ManualDrivingFallback">

                            <Parallel name="ManDriveAndMainParallel" success_threshold="1" failure_threshold="1">
                                
                                <CheckManualDriving/>

                                <Fallback name="BatteryLowFallback">

                                    <Parallel name="RootParallel" success_threshold="1" failure_threshold="1">

                                        <BatteryOk robotLocationBAT="{robotLocationBAT}"
                                                   chargingInteger="{chargingInteger}"
                                                   chargingInteger_nextCycle="{chargingInteger_nextCycle}"/>

                                        <ForceSuccess name="MainFallbackForceSuccess">
                                            <Fallback name="MainFallback">

                                                <Sequence name="MainSequence">

                                                    <Fallback name="CheckWorkingZone">
                                                        <CheckInWorkingZone robotLocationBAT="{robotLocationBAT}" />

                                                        <Sequence name="GoToWorkAreaSequence">
                                                            <DriveWorkArea 
                                                                timeout="5.0"
                                                                x="-2.2921230792999268" 
                                                                y="2.3765931129455566" 
                                                                z="0.0033969879150390625"
                                                                qx="0.0" qy="0.0" qz="0.7071068" qw="0.7071068"
                                                                workarea_timestamp="{workarea_timestamp}" 
                                                            />
                                                            <IsRobotAtWorkArea 
                                                                timeout="200.0"
                                                                workarea_timestamp="{workarea_timestamp}" 
                                                            />
                                                        </Sequence>
                                                    </Fallback>

                                                    <RobotExplore robotLocation="{robotLocation}"/>

                                                    <LoopSequence name="LoopSequence">
                                                        <Sequence name="FollowMeSequence">
                                                            <StartDrivingToPeople timeout="5.0"/>
                                                            <CheckingNearbyVisitors/>
                                                            <ArrivedAtVisitors timeout="20.0"/>
                                                        </Sequence>
                                                    </LoopSequence>

                                                    <DriveQuizLocation 
                                                        timeout="5.0" 
                                                        x="1.9707672595977783" y="0.4888995885848999" z="0.0"
                                                        qx="0.0" qy="0.0" qz="0.9599275506038583" qw="0.28024827848120143"
                                                        sent_timestamp="{quiz_timestamp}" 
                                                    />

                                                    <IsRobotAtQuiz 
                                                        timeout="200.0" 
                                                        sent_timestamp="{quiz_timestamp}" 
                                                    />

                                                    <RobotAtQuiz robotLocation="{robotLocation}"/>
                                                    <WaitQuizToEnd timeout="10.0"/>

                                                </Sequence>

                                                <MainBTStopDrive stop_flag="{stop_flag}"/>

                                            </Fallback>
                                        </ForceSuccess>

                                    </Parallel>

                                    <Fallback name="GoToChargeFallback">
                                        <Sequence name="ChargingSequence">
                                            <CheckMainBTErrorState stop_flag="{stop_flag}"/>
                                            <DriveToChargingStation timeout="5.0"
                                                                    chargingInteger="{chargingInteger}" />

                                            <StatusDriveToChargingDock timeout="200.0"
                                                chargingInteger="{chargingInteger}"
                                                chargingInteger_nextCycle="{chargingInteger_nextCycle}" 
                                            />
                                            <IsRobotCharging timeout="200"
                                                chargingInteger="{chargingInteger}" 
                                            />
                                            <IsBatteryFull robotLocation="{robotLocation}"    
                                                chargingInteger="{chargingInteger}"
                                            />

                                            <RobotWaitInChargingStation />
                                            
                                            <StopRobotCharging chargingInteger="{chargingInteger}" />
                                            
                                            <BatteryCharged timeout="5" robotLocationBAT="{robotLocationBAT}"/>
                                        </Sequence>

                                        <BatteryStopDrive/>
                                    </Fallback>

                                </Fallback> </Parallel> <Sequence name="ManualDrivingSequence">
                                <ManualDriving/>
                                <MDForceCharging 
                                    x="-2.431073133504586"
                                    y="2.2872283293439244"
                                    z="0.0"
                                    qx="0.0" qy="0.0" qz="0.4284720675699097" qw="0.9035550272741372"
                                />
                            </Sequence>

                        </Fallback> </Parallel>

                    <WaitDriving/>

                </Fallback>
            </Parallel>

            <StopNode/>

        </Fallback>
    </BehaviorTree>
</root>
